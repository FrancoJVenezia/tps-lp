permisos 'Campus virtual'
  rol 'alumno'
    puede ver 'materias'
    puede ver 'notas'
    puede crear 'entregas'
  rol 'ayudante' hereda 'alumno'
    puede ver 'entregas'
    puede editar 'notas'
  rol 'profesor' hereda 'ayudante'
    puede todo 'materias'
    puede todo 'notas'
    # las notas cerradas no se borran: todo menos borrar
    no puede borrar 'notas'
  rol 'administrativo'
    puede ver 'materias'
    puede todo 'inscripciones'
  # un alumno suspendido sigue viendo sus notas pero no puede entregar
  rol 'suspendido' hereda 'alumno'
    no puede crear 'entregas'
