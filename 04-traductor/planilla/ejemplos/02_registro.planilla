# Formulario de registro
formulario 'Registro' post='api/registro' tema=oscuro
  seccion 'Datos personales'
    texto nombre='Nombre' placeholder='Tu nombre' obligatorio
    numero nombre='Edad' min=18 max=99 mensaje='Tenés que ser mayor de edad'
  seccion 'Cuenta'
    email nombre='Correo' obligatorio
    clave nombre='Contraseña' ayuda='Mínimo 8 caracteres' obligatorio
    casilla nombre='Acepto los términos' obligatorio
  boton 'Crear cuenta'
