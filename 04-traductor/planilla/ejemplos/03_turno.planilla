formulario 'Pedir turno' post='api/turnos' tema=azul
  seccion 'Paciente'
    fila
      texto nombre='Nombre' obligatorio
      texto nombre='Apellido' obligatorio
    fila
      numero nombre='DNI' obligatorio
      fecha nombre='Fecha de nacimiento'
  seccion 'Turno'
    opciones nombre='Especialidad' ('Clínica', 'Pediatría', 'Traumatología') obligatorio
